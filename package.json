{
  "name": "httpdash",
  "version": "1.0.0",
  "description": "HttpDash - a Postman-like API client built with Electron",
  "main": "src/main/main.js",
  "author": "restimguay",
  "license": "MIT",
  "httpdash": {
    "updateRepo": "restimguay/httpdash",
    "buyMeACoffee": "https://buymeacoffee.com/restiguayw"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "cli": "node bin/httpdash.js"
  },
  "dependencies": {
    "chai": "4.5.0",
    "codemirror": "5.65.21",
    "ldapts": "^9.2.0"
  },
  "devDependencies": {
    "electron": "43.7.8",
    "electron-builder": "26.15.3",
    "ldapjs": "^3.0.7"
  },
  "build": {
    "appId": "com.httpdash.app",
    "productName": "HttpDash",
    "copyright": "Copyright © 2026 restimguay",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/codemirror/{src,theme,keymap,bin}/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "bin": {
    "httpdash": "bin/httpdash.js"
  }
}
